{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyForge",
  "version": "0.1.0",
  "identifier": "dev.studyforge.desktop",
  "mainBinaryName": "studyforge-desktop",
  "build": {
    "beforeDevCommand": "bun run dev:client",
    "devUrl": "http://127.0.0.1:65001",
    "beforeBuildCommand": "bun run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "StudyForge",
        "width": 1280,
        "height": 800,
        "minWidth": 1060,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "companion",
        "title": "阿夏",
        "url": "/?window=companion",
        "width": 340,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' blob: http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "Education",
    "shortDescription": "一位会陪学生长期学习的本地教师",
    "longDescription": "StudyForge 将自由学习、学习资产与 Roadmap—Plan—Lesson 正式课程保存在学生自己的 Markdown 学习集中。",
    "externalBin": [
      "binaries/studyforge-runtime",
      "binaries/studyforge-pi"
    ],
    "resources": {
      "resources/studyforge/": "studyforge/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
