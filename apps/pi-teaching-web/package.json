{
  "name": "studyforge-pi-teaching-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "pi": {
    "extensions": ["./src/pi-extension.ts"],
    "skills": ["./resources/skills"]
  },
  "scripts": {
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "bun run --parallel dev:server dev:client",
    "start": "bun run src/server/index.ts",
    "build": "vite build",
    "test": "bun test --path-ignore-patterns='tests/e2e/**'",
    "test:e2e": "playwright test",
    "validate:m1a": "bun run scripts/m1a-validation/cli.ts",
    "validate:m1c": "bun run scripts/m1c-validation/cli.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-coding-agent": "0.81.0",
    "katex": "0.18.1",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "pdfjs-dist": "5.4.624",
    "pi-subagents": "0.35.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0"
  }
}
